{
  "name": "mage2mcp-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation linting and link checking for mage2mcp",
  "license": "Apache-2.0",
  "scripts": {
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint:links": "find . -name '*.md' -not -path './node_modules/*' -not -path './.git/*' -print0 | xargs -0 -n1 markdown-link-check -q -c .markdown-link-check.json"
  },
  "devDependencies": {
    "markdown-link-check": "3.15.0",
    "markdownlint-cli2": "0.24.1"
  }
}
