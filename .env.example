# Development-only environment template.
#
# Copy to .env (git-ignored) and fill in real values. Never commit secrets.
# Production deployments should use a secret manager instead of a file.

# Cloudflare Access (authentication)
MAGE2MCP_AUTH_ISSUER=https://your-team.cloudflareaccess.com
MAGE2MCP_AUTH_AUDIENCE=your-access-application-aud
MAGE2MCP_AUTH_JWKS_URL=https://your-team.cloudflareaccess.com/cdn-cgi/access/certs

# Listener (loopback by default)
MAGE2MCP_LISTEN=127.0.0.1:8080
MAGE2MCP_LOG_LEVEL=info

# Magento integration credential (OAuth 1.0a consumer key/secret or token)
# Magento credential forms:
#   bearer:<integration-access-token>   (store must enable integration-as-bearer)
#   oauth1:<consumer-key>:<consumer-secret>:<token>:<token-secret>
MAGENTO_US_CREDENTIAL=

# Cloudflare API token (read-only profile by default)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# GA4 service account (one per property)
GA4_SERVICE_ACCOUNT=
